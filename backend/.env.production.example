# Copy to backend/.env only on a production host if running outside Compose.
# Do not commit real credentials.

ENVIRONMENT=production
DEBUG=false
DATABASE_URL=
INVITATION_EMAIL_DELIVERY=disabled
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USERNAME=
INVITATION_SMTP_PASSWORD=
INVITATION_SMTP_FROM_ADDRESS=
INVITATION_SMTP_FROM_NAME=LeafletPilot
INVITATION_SMTP_SECURITY=starttls
INVITATION_SMTP_TIMEOUT_SECONDS=15

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

PLATFORM_ADMIN_ENABLED=false
PLATFORM_JWT_SECRET=
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=240
PUBLIC_SIGNUP_THROTTLE_SECRET=
PUBLIC_SIGNUP_THROTTLE_WINDOW_MINUTES=60
PUBLIC_SIGNUP_THROTTLE_LIMIT=3

# Pydantic JSON list formatting is required.
BACKEND_CORS_ORIGINS=["https://app.example.com"]
FRONTEND_BASE_URL=https://app.example.com
TRUSTED_HOSTS=["api.example.com","127.0.0.1","localhost","backend"]
# Required when running behind Traefik/another reverse proxy on the same
# Docker network (the documented topology). The public signup IP throttle
# (PUBLIC_SIGNUP_THROTTLE_*) only trusts X-Forwarded-For from peers listed
# here; left blank, every request appears to originate from the proxy
# container's own IP, so distinct real users share one throttle bucket and
# legitimate signups get wrongly blocked once the window's limit is hit.
# Set to the proxy's container/network CIDR, e.g. ["172.20.0.0/16"].
TRUSTED_PROXY_IPS=
LOCAL_STORAGE_DIR=/app/storage
LOG_LEVEL=INFO
# Optional, default 7. How many days an owner invitation link stays valid.
INVITATION_EXPIRE_DAYS=7

# Keep disabled in production unless an explicitly isolated demo database is being operated.
DEMO_OPERATIONS_ENABLED=false
DEMO_MARKET_ID=
DEMO_MARKET_SLUG=
DEMO_OWNER_EMAIL=

TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_HTTP_TIMEOUT_SECONDS=20
TELEGRAM_HTTP_MAX_ATTEMPTS=1

# Keep disabled until the live-mode billing promotion task explicitly enables it.
# STRIPE_SECRET_KEY must be a live key (sk_live_/rk_live_) only once ENVIRONMENT=production;
# this repo/PR never sets one.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOOKUP_KEY_STARTER=leafletpilot_starter_monthly_eur
STRIPE_PRICE_LOOKUP_KEY_STANDARD=leafletpilot_standard_monthly_eur
STRIPE_PRICE_LOOKUP_KEY_PRO=leafletpilot_pro_monthly_eur
# Leave blank to auto-derive from FRONTEND_BASE_URL as
# "<FRONTEND_BASE_URL>/#/settings/billing[?checkout=success|cancel]" — the
# frontend is a hash router with no server-side routes, so a URL here MUST
# include the "/#/" segment or Stripe will bounce the user to the public
# landing page instead of the authenticated Billing page after checkout.
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
# VAT/TVA is not collected yet — keep this false. Do not enable in production.
STRIPE_AUTOMATIC_TAX_ENABLED=false

# --- Central WhatsApp channel (Evolution API) ---
# Keep disabled unless a dedicated Evolution API v2 instance and a dedicated
# WhatsApp number have been provisioned. The number MUST NOT be one already
# registered to someone's personal WhatsApp account in use — connecting it
# takes over that session. Evolution API is NOT deployed by this repo's
# compose files; it is an external/self-hosted dependency LeafletPilot
# connects to (see deploy/evolution/docker-compose.evolution.example.yml for
# a reference stack, and docs/backend/10_WHATSAPP_EVOLUTION_SETUP.md for the
# full operator runbook: instance creation, QR pairing, webhook registration,
# verification smoke test, rollback).
EVOLUTION_WHATSAPP_ENABLED=false
# Evolution API base URL, e.g. https://evolution.example.com. Must use HTTPS
# in production unless it is a private container hostname
# (localhost/127.0.0.1/evolution-api/evolution) — see
# app/core/config.py::_validate_enabled_evolution_settings.
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Required (>=32 chars, non-placeholder) when EVOLUTION_WHATSAPP_ENABLED=true.
# Evolution does not sign webhook payloads — this shared secret, sent back as
# the X-Evolution-Webhook-Token header and compared in constant time, is the
# strongest available control on that endpoint. Never reuse
# TELEGRAM_WEBHOOK_SECRET or any other secret for this value.
# Generate with: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# E.164 form only, e.g. +33612345678.
LEAFLETPILOT_WHATSAPP_NUMBER=
EVOLUTION_HTTP_TIMEOUT_SECONDS=20
WHATSAPP_VERIFICATION_EXPIRE_MINUTES=10
WHATSAPP_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_VERIFICATION_MAX_ATTEMPTS=5
WHATSAPP_RATE_LIMIT_WINDOW_MINUTES=10
WHATSAPP_VERIFICATION_REQUEST_LIMIT=5
WHATSAPP_INBOUND_MESSAGE_LIMIT=60
WHATSAPP_WEBHOOK_IP_LIMIT=600
# AI-2 provider-neutral revision parsing (enable only with a configured provider)
AI_ENABLED=false
AI_REVISION_ENABLED=false
AI_REVISION_PROVIDER=openai_compatible
AI_REVISION_MODEL=
AI_COMPLEX_REVISION_PROVIDER=
AI_COMPLEX_REVISION_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_OPENAI_COMPATIBLE_API_BASE_URL=https://api.openai.com/v1
AI_OPENAI_COMPATIBLE_API_KEY=
AI_HTTP_TIMEOUT_SECONDS=15
AI_IMAGE_HTTP_TIMEOUT_SECONDS=120
AI_HTTP_MAX_ATTEMPTS=2
AI_MAX_INSTRUCTION_LENGTH=2000
AI_MAX_ACTIONS_PER_REQUEST=20
AI_PROPOSAL_EXPIRE_MINUTES=15
AI_REVISION_RATE_LIMIT_PER_MINUTE=5
