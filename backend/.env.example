APP_NAME=LeafletPilot API
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://leafletpilot:leafletpilot@localhost:5432/leafletpilot
TEST_DATABASE_URL=postgresql+asyncpg://leafletpilot:leafletpilot@localhost:5432/leafletpilot_test_suite
INVITATION_EMAIL_DELIVERY=disabled
INVITATION_SMTP_HOST=
INVITATION_SMTP_PORT=587
INVITATION_SMTP_USERNAME=
INVITATION_SMTP_PASSWORD=
INVITATION_SMTP_FROM_ADDRESS=
INVITATION_SMTP_FROM_NAME=LeafletPilot
INVITATION_SMTP_SECURITY=starttls
INVITATION_SMTP_TIMEOUT_SECONDS=15
LOCAL_STORAGE_DIR=storage
LOG_LEVEL=INFO

# Disabled by default. Enable only in an isolated demo environment and set all three allow-list values.
DEMO_OPERATIONS_ENABLED=false
DEMO_MARKET_ID=
DEMO_MARKET_SLUG=
DEMO_OWNER_EMAIL=
# Required only to create a missing synthetic owner; never log or commit this value.
DEMO_OWNER_INITIAL_PASSWORD=

# Development placeholder only. Set a strong secret in deployed environments.
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

PLATFORM_ADMIN_ENABLED=false
PLATFORM_JWT_SECRET=change-this-platform-secret-at-least-32-chars
PLATFORM_ACCESS_TOKEN_EXPIRE_MINUTES=240
PUBLIC_SIGNUP_THROTTLE_SECRET=change-this-signup-throttle-secret-at-least-32-chars
PUBLIC_SIGNUP_THROTTLE_WINDOW_MINUTES=60
PUBLIC_SIGNUP_THROTTLE_LIMIT=3
TRUSTED_PROXY_IPS=

# Disabled by default. Sandbox/TEST mode only — never put a live secret key here.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOOKUP_KEY_STARTER=leafletpilot_starter_monthly_eur
STRIPE_PRICE_LOOKUP_KEY_STANDARD=leafletpilot_standard_monthly_eur
STRIPE_PRICE_LOOKUP_KEY_PRO=leafletpilot_pro_monthly_eur
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
STRIPE_AUTOMATIC_TAX_ENABLED=false

# --- Central WhatsApp channel (Evolution API) ---
# Disabled by default. ONE platform-owned WhatsApp number driven by ONE
# Evolution API v2 instance, shared by all markets — see
# docs/backend/10_WHATSAPP_EVOLUTION_SETUP.md. Evolution API itself is not
# part of this repo's stack; it is an external/self-hosted dependency.
EVOLUTION_WHATSAPP_ENABLED=false
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
# Required (>=32 chars, non-placeholder) when EVOLUTION_WHATSAPP_ENABLED=true.
# Sent back by Evolution as the X-Evolution-Webhook-Token header on every
# webhook delivery and compared in constant time.
# Generate with: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=
# E.164 form only, e.g. +33612345678. Required when the channel is enabled.
LEAFLETPILOT_WHATSAPP_NUMBER=
EVOLUTION_HTTP_TIMEOUT_SECONDS=20
WHATSAPP_VERIFICATION_EXPIRE_MINUTES=10
WHATSAPP_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_VERIFICATION_MAX_ATTEMPTS=5
WHATSAPP_RATE_LIMIT_WINDOW_MINUTES=10
WHATSAPP_VERIFICATION_REQUEST_LIMIT=5
WHATSAPP_INBOUND_MESSAGE_LIMIT=60
WHATSAPP_WEBHOOK_IP_LIMIT=600
