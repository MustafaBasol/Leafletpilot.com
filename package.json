{
  "name": "leafletpilot-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate.mjs",
    "test:platform": "node --test src/pages/platform/platformOps.test.mjs src/pages/platform/platformCatalogUtils.test.mjs src/pages/platform/catalogQuality.test.mjs src/pages/platform/PlatformMarketProductImportModal.test.mjs src/pages/platform/PlatformBilling.test.mjs src/pages/platform/PlatformMarketList.test.mjs src/api/platformApi.test.mjs",
    "test:campaign": "node --test src/pages/newCampaignFinalize.test.mjs src/pages/NewCampaign.preview.test.mjs src/pages/CampaignDetail.preview.test.mjs",
    "test:plans": "node --test src/api/publicApi.test.mjs src/pages/Landing.test.mjs",
    "test:capabilities": "node --test src/routes/capabilities.test.mjs",
    "test:whatsapp": "node --test src/pages/whatsappStatus.test.mjs src/pages/WhatsAppTeamPanel.test.mjs src/pages/platform/whatsappOps.test.mjs src/pages/platform/PlatformWhatsApp.test.mjs",
    "test:billing-ui": "node --test src/App.routing.test.mjs src/pages/Billing.checkout.test.mjs src/pages/Billing.cancelPlanChange.test.mjs src/components/ui/PlanChangeModal.test.mjs src/routes/routes.navIcons.test.mjs",
    "test:e2e:phase-d": "python scripts/phase_d_playwright.py",
    "test:e2e:phase-f": "python scripts/phase_f_playwright.py",
    "smoke": "node scripts/smoke-vite.mjs && node scripts/smoke-brand-assets.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
